{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && engram index >/dev/null 2>&1; exit 0",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
