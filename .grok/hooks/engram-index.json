{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|write|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${GROK_WORKSPACE_ROOT:-${CLAUDE_PROJECT_DIR:-.}}\" && engram index >/dev/null 2>&1; exit 0",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
